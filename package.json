    "ios": "npm run ios --workspace apps/mobile",
    "lint": "eslint . --ext .js,.jsx",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "vitest": "^1.5.0"
  }
}
